<div class="mbf-table-body standard-form">
  <p class="hint">{{localize "MBF.Table.Intro"}}</p>
  <table class="mbf-table">
    <thead>
      <tr>
        <th></th>
        {{#each columns}}
        <th>{{localize label}}<br><span class="mbf-dc">DC {{dc}}</span></th>
        {{/each}}
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr>
        <th class="mbf-row-label">{{localize label}}</th>
        {{#each cells}}
        <td>
          <div class="mbf-cell">
            {{#each dice}}
            <input type="number" class="mbf-dice-{{kind}}" name="{{name}}" value="{{value}}" min="0" max="{{@root.max}}" step="1" data-tooltip="{{title}}">
            {{/each}}
          </div>
        </td>
        {{/each}}
      </tr>
      {{/each}}
    </tbody>
  </table>
  <p class="mbf-legend">
    {{#each kinds}}<span class="mbf-legend-{{@index}}">{{short}} (d{{die}})</span>{{/each}}
  </p>
</div>

<footer class="form-footer">
  <button type="button" data-action="reset"><i class="fa-solid fa-rotate-left"></i> {{localize "MBF.Table.Reset"}}</button>
  <button type="submit"><i class="fa-solid fa-floppy-disk"></i> {{localize "MBF.Table.Save"}}</button>
</footer>
